rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStudent() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STUDENT';
    }
    
    function isStaff() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STAFF';
    }

    function isRegistrar() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REGISTRAR';
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isStaffOrHigher() {
      return isStaff() || isRegistrar() || isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffOrHigher());
      
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role in ['STUDENT', 'STAFF']
                    && request.resource.data.status == 'ACTIVE';
                    
      allow update: if isAuthenticated() && (
                      (request.auth.uid == userId 
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status) 
                      || 
                      (isAdmin() && request.auth.uid != userId)
                    );
                    
      allow delete: if false; // Users shouldn't be deleted, only marked as disabled
    }

    match /documentTypes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated() && (isStaffOrHigher() || resource.data.studentUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isAuthenticated() && (isStaffOrHigher() || resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /requestRequirements/{reqId} {
      allow read: if isAuthenticated() && (isStaffOrHigher() || resource.data.studentUid == request.auth.uid);
      allow create, update: if isAuthenticated() && (isStaffOrHigher() || request.resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
    }

    match /requestHistory/{histId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
